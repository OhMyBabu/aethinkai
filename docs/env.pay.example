# WijayaPay QRIS — copy to /root/.secrets/aethink-pay.env (chmod 600)
WIJAYAPAY_BASE_URL=https://gateway.wijayapay.com/api
WIJAYAPAY_MERCHANT=WP..............
WIJAYAPAY_API_KEY=................
PAY_CALLBACK_URL=https://<domain>/api/pay/webhook/wijayapay
# reconciler is OFF by default; webhook + the "Cek status" button are enough
# PAY_RECONCILE=1
# PAY_RECONCILE_SECONDS=300
