# copy to /root/.secrets/aethink-db.env (chmod 600) — loaded by gateway/app/config.py,
# by systemd (EnvironmentFile) and by the seed/test scripts.
DATABASE_URL=postgresql://aethink:CHANGE_ME@127.0.0.1:5432/aethink
INTERNAL_SECRET=CHANGE_ME_32_HEX
JWT_SECRET=CHANGE_ME_32_HEX

# Upstream 9Router.
#   loopback instance  -> UPSTREAM_BASE_URL=http://127.0.0.1:20128/v1 + NINEROUTER_PEER_TOKEN
#   remote relay       -> UPSTREAM_BASE_URL=https://<relay>:20128/v1 + UPSTREAM_KEY (Bearer)
UPSTREAM_BASE_URL=http://127.0.0.1:20128/v1
UPSTREAM_KEY=
NINEROUTER_PEER_TOKEN_FILE=/root/services/.9router-peer
UPSTREAM_TIMEOUT=300
# catalogue cache in seconds: 1.2k upstream models take ~7 s, dashboards need them instantly
UPSTREAM_MODELS_TTL=60

USD_IDR=16250
AETHINK_MINIAPP_URL=
AETHINK_BOT_ENV=/root/.secrets/aethink-bot.env
